{
  "name": "jungle-backend-challenge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0 <2"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit",
    "test:integration": "bun test --timeout 30000 test/integration",
    "test:distributed": "bun test --timeout 60000 test/distributed",
    "test:broker": "bun test test/broker",
    "test:broker:durability": "bun test ./test/broker/durability.acceptance.ts",
    "migration:run": "bun scripts/migrate.ts up",
    "migration:revert": "bun scripts/migrate.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "decimal.js": "^10.6.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/express": "^5.0.0",
    "typescript": "^5.9.0"
  }
}
